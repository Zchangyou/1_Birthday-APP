<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="设置"
        android:background="@color/primary"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 提醒时间 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="提醒设置"
                android:textSize="12sp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:paddingHorizontal="4dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/row_reminder_time"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reminder_time_label"
                    android:textSize="16sp"
                    android:textColor="#FF1C1B1F" />

                <TextView
                    android:id="@+id/tv_reminder_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 分隔 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FFE7E0EC"
                android:layout_marginVertical="12dp" />

            <!-- 数据备份/恢复 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="数据备份"
                android:textSize="12sp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:paddingHorizontal="4dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/row_export"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/export_data"
                    android:textSize="16sp"
                    android:textColor="#FF1C1B1F" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_import"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/import_data"
                    android:textSize="16sp"
                    android:textColor="#FF1C1B1F" />
            </LinearLayout>

            <!-- 分隔 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FFE7E0EC"
                android:layout_marginVertical="12dp" />

            <!-- 后台运行 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="后台运行"
                android:textSize="12sp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:paddingHorizontal="4dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/row_battery_optimization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="4dp"
                android:paddingVertical="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_optimization"
                    android:textSize="16sp"
                    android:textColor="#FF1C1B1F" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_optimization_desc"
                    android:textSize="13sp"
                    android:textColor="#FF49454F"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_honor_protected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="4dp"
                android:paddingVertical="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/honor_protected"
                    android:textSize="16sp"
                    android:textColor="#FF1C1B1F" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/honor_protected_desc"
                    android:textSize="13sp"
                    android:textColor="#FF49454F"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
